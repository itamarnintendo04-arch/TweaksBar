<Window x:Class="TweaksBar.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TweaksBar" Height="720" Width="1120"
        MinHeight="620" MinWidth="940"
        Background="{StaticResource WindowBrush}"
        Foreground="#F4F4F5"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,24">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="TweaksBar" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="iPhone customization companion" Foreground="#9CA3AF" FontSize="13" Margin="1,4,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#1D2431" CornerRadius="14" Padding="12,7" VerticalAlignment="Center">
                <TextBlock Text="PREVIEW BUILD" Foreground="#C4B5FD" FontSize="11" FontWeight="Bold"/>
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="0.85*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="24">
                <StackPanel>
                    <TextBlock Text="Device connection" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock Text="Connect your iPhone to get started." Foreground="#9CA3AF" Margin="0,7,0,22"/>
                    <Border Background="#0E121B" CornerRadius="14" Padding="18" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="No iPhone connected" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ConnectionStatus" Text="Start by checking Apple device support, then open TweaksBar on your iPhone." Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Discover iPhone" Height="44" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="DiscoverButton_Click"/>
                    <TextBlock Text="Discovery will use your local network. Approve the connection on your iPhone before pairing." Foreground="#9CA3AF" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="22" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Apple device support" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DriverStatus" Text="Not checked yet" Foreground="#9CA3AF" Margin="0,7,0,16"/>
                        <Button Content="Check drivers" Height="40" Background="#293244" Foreground="White" BorderThickness="0" Click="CheckDriversButton_Click"/>
                        <Button Content="Install / repair Apple components" Height="40" Margin="0,9,0,0" Background="#202635" Foreground="#DDD6FE" BorderThickness="0" Click="InstallDriversButton_Click"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Wi-Fi Sync" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Enable wireless sync yourself in Apple Devices or iTunes after trusting this PC over USB." Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,8,0,14"/>
                        <Button Content="Show setup instructions" Height="40" Background="#202635" Foreground="White" BorderThickness="0" Click="WifiHelpButton_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Text="Diagnostics prototype · No jailbreak or system tweaks are installed by this build." Foreground="#737B8C" FontSize="11" Margin="2,20,0,0"/>
    </Grid>
</Window>
