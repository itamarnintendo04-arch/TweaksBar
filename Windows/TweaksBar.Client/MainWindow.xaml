<Window x:Class="TweaksBar.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TweaksBar" Height="860" Width="1440" MinHeight="760" MinWidth="1120"
        Background="#080D18" Foreground="#F5F7FC" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#101827"/>
        <SolidColorBrush x:Key="Surface2" Color="#151F31"/>
        <SolidColorBrush x:Key="Muted" Color="#8C9BB2"/>
        <SolidColorBrush x:Key="Accent" Color="#4D8DFF"/>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="46"/><Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="15,0"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#AAB7CA"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="44"/><Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#397CF2"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#202D42"/><Setter Property="Foreground" Value="#DCE7F8"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="#202D41"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="22"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F4F7FC"/>
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#0D1523" BorderBrush="#1B293D" BorderThickness="0,0,1,0" Padding="20">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="2,5,0,34">
                        <Border Width="43" Height="43" CornerRadius="13" Background="#276BE4">
                            <Grid>
                                <TextBlock Text="T" FontSize="26" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse Width="8" Height="8" Fill="#8FC4FF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,7,0"/>
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="TweaksBar" FontSize="19" FontWeight="Bold" Foreground="#F5F8FF"/>
                            <TextBlock Text="IPHONE TOOLKIT" FontSize="9" FontWeight="Bold" Foreground="#71849F" Margin="1,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="#60728D" Margin="9,0,0,10"/>
                    <Button x:Name="OverviewNav" Style="{StaticResource NavButton}" Content="◫    Overview" Background="#1A3154" Foreground="#82B6FF" Click="OverviewNav_Click"/>
                    <Button x:Name="InstallNav" Style="{StaticResource NavButton}" Content="⇧    Install IPA" Click="InstallNav_Click"/>
                    <Button x:Name="DevicesNav" Style="{StaticResource NavButton}" Content="▣    Device support" Click="DevicesNav_Click"/>
                    <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Content="⚙    Settings" Click="SettingsNav_Click"/>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="#142238" BorderBrush="#233957" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,18,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#F2B85D" Margin="0,0,8,0"/>
                            <TextBlock Text="SETUP REQUIRED" FontSize="9" FontWeight="Bold" Foreground="#E8C27E"/>
                        </StackPanel>
                        <TextBlock Text="Connect your iPhone by USB and trust this computer to get started." FontSize="11" Foreground="#A8B8CE" TextWrapping="Wrap" Margin="0,9,0,0" LineHeight="17"/>
                    </StackPanel>
                </Border>
                <TextBlock DockPanel.Dock="Bottom" Text="TweaksBar Preview  •  0.2.0" Foreground="#56667D" FontSize="10" Margin="3,14,0,0"/>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="34,27,34,28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,25">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Overview" FontSize="28" FontWeight="Bold"/>
                    <TextBlock x:Name="PageSubtitle" Text="Your iPhone workspace, all in one place." Foreground="#8C9BB2" FontSize="13" Margin="1,5,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#142238" BorderBrush="#263B5A" BorderThickness="1" CornerRadius="20" Padding="13,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#F2B85D" Margin="0,0,8,0"/>
                        <TextBlock x:Name="HeaderDeviceStatus" Text="NO DEVICE" FontSize="10" FontWeight="Bold" Foreground="#D7E4F8"/>
                    </StackPanel>
                </Border>
            </DockPanel>

            <Grid Grid.Row="1">
                <!-- OVERVIEW -->
                <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border CornerRadius="20" Padding="26" Margin="0,0,0,20" BorderBrush="#315B91" BorderThickness="1">
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#173C70" Offset="0"/><GradientStop Color="#17243D" Offset="1"/></LinearGradientBrush></Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="YOUR IPHONE. YOUR WORKSPACE." Foreground="#9DC7FF" FontSize="10" FontWeight="Bold" CharacterSpacing="1.3"/>
                                    <TextBlock Text="Everything starts with a connection." FontSize="24" FontWeight="Bold" Margin="0,10,0,7"/>
                                    <TextBlock Text="Connect your iPhone over USB, import an IPA, and manage your installation workflow from one clean desktop app." Foreground="#C0D2EB" FontSize="12" TextWrapping="Wrap" MaxWidth="650" LineHeight="19"/>
                                    <Button Content="Open IPA installer  →" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,19,0,0" Click="InstallNav_Click"/>
                                </StackPanel>
                                <Viewbox Grid.Column="1" Width="130" Height="130" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid Width="130" Height="130">
                                        <Ellipse Fill="#244C80" Opacity="0.7"/>
                                        <Ellipse Width="78" Height="78" Stroke="#8FC1FF" StrokeThickness="5"/>
                                        <Path Data="M 39,67 L 88,27 M 75,25 L 91,22 L 88,38" Stroke="#FFFFFF" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Ellipse Width="12" Height="12" Fill="#FFFFFF"/>
                                    </Grid>
                                </Viewbox>
                            </Grid>
                        </Border>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel><TextBlock Text="DEVICE" Foreground="#7588A3" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="DeviceMetric" Text="Not connected" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,5"/><TextBlock Text="USB connection status" Style="{StaticResource MutedText}"/></StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel><TextBlock Text="APPLE SUPPORT" Foreground="#7588A3" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="DriverMetric" Text="Not checked" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,5"/><TextBlock Text="Windows device drivers" Style="{StaticResource MutedText}"/></StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource Card}">
                                <StackPanel><TextBlock Text="IPA WORKSPACE" Foreground="#7588A3" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="PackageMetric" Text="No package" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,5"/><TextBlock Text="Imported install packages" Style="{StaticResource MutedText}"/></StackPanel>
                            </Border>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Get started" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="A quick setup checklist for your first session." Style="{StaticResource MutedText}" Margin="0,5,0,17"/>
                                    <TextBlock Text="01   Connect iPhone with a USB cable" FontSize="12" Foreground="#D9E3F1" Margin="0,0,0,13"/>
                                    <TextBlock Text="02   Unlock your phone and tap Trust" FontSize="12" Foreground="#D9E3F1" Margin="0,0,0,13"/>
                                    <TextBlock Text="03   Import an IPA or a TweaksBar release ZIP" FontSize="12" Foreground="#D9E3F1"/>
                                    <Button Content="Check Apple device support" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,19,0,0" Click="DevicesNav_Click"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Built for a clear workflow" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Package handling" Foreground="#E6EDF8" FontWeight="SemiBold" Margin="0,15,0,4"/>
                                    <TextBlock Text="Import IPA files directly or extract IPA packages from ZIP releases." Style="{StaticResource MutedText}"/>
                                    <TextBlock Text="Signing & installation" Foreground="#E6EDF8" FontWeight="SemiBold" Margin="0,13,0,4"/>
                                    <TextBlock Text="Device installation will be enabled after the Apple signing and USB install bridge is integrated." Style="{StaticResource MutedText}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- INSTALL -->
                <ScrollViewer x:Name="InstallPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Import an app package" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Choose an IPA file or a TweaksBar ZIP release. ZIP imports are inspected and IPA files are extracted into your local package library." Style="{StaticResource MutedText}" Margin="0,7,0,18"/>
                                <Border BorderBrush="#304765" BorderThickness="1" Background="#0C1421" CornerRadius="14" Padding="22">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="⇧" FontSize="34" Foreground="#72A9FF" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Drop an IPA or ZIP here" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                                        <TextBlock Text="or browse your computer" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                                        <Button Content="Browse files" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" Click="BrowsePackageButton_Click"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="ImportStatus" Text="No package imported yet." Style="{StaticResource MutedText}" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Packages found" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Select an IPA extracted from the ZIP or imported directly." Style="{StaticResource MutedText}" Margin="0,5,0,14"/>
                                <ListBox x:Name="PackageList" Background="#0C1421" Foreground="#EAF1FB" BorderBrush="#293A52" BorderThickness="1" Padding="8" MinHeight="120" SelectionChanged="PackageList_SelectionChanged">
                                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5,7"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#EAF1FB"/><TextBlock Text="{Binding Detail}" Foreground="#8395AF" FontSize="10" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SelectedPackageStatus" Text="Select a package to see its status." Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Install to iPhone" Style="{StaticResource PrimaryButton}" IsEnabled="False" x:Name="InstallButton" Click="InstallButton_Click"/>
                                </Grid>
                                <TextBlock Text="Installation is not active in this preview: Apple signing and the device installation bridge are not yet connected." Foreground="#E6BD76" FontSize="11" TextWrapping="Wrap" Margin="0,13,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- DEVICE SUPPORT -->
                <ScrollViewer x:Name="DevicesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="iPhone connection" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Connect your iPhone with USB, unlock it, and approve Trust This Computer. Windows must have Apple's device support components." Style="{StaticResource MutedText}" Margin="0,7,0,16"/>
                                <Border Background="#0C1421" CornerRadius="13" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="USB DEVICE" Foreground="#7186A3" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock x:Name="ConnectionStatus" Text="No device has been verified." FontSize="16" FontWeight="SemiBold" Margin="0,7,0,4"/>
                                        <TextBlock Text="This preview checks Apple support components. It does not yet enumerate connected iPhones." Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Apple device support" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="DriverStatus" Text="Not checked yet." Style="{StaticResource MutedText}" Margin="0,7,0,16"/>
                                <WrapPanel>
                                    <Button Content="Check drivers" Style="{StaticResource PrimaryButton}" Click="CheckDriversButton_Click" Margin="0,0,10,0"/>
                                    <Button Content="Apple support page" Style="{StaticResource SecondaryButton}" Click="InstallDriversButton_Click"/>
                                </WrapPanel>
                                <TextBlock Text="Wi-Fi Sync" Foreground="#E6EDF8" FontWeight="SemiBold" Margin="0,22,0,5"/>
                                <TextBlock Text="Wi-Fi Sync can be enabled manually in Apple Devices or iTunes after the initial USB trust step." Style="{StaticResource MutedText}" Margin="0,0,0,13"/>
                                <Button Content="Show Wi-Fi Sync instructions" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="WifiHelpButton_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- SETTINGS -->
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Application" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="TweaksBar desktop preview" Foreground="#E6EDF8" FontWeight="SemiBold" Margin="0,18,0,4"/>
                                <TextBlock Text="Version 0.2.0 · Windows x64" Style="{StaticResource MutedText}"/>
                                <TextBlock Text="Package storage" Foreground="#E6EDF8" FontWeight="SemiBold" Margin="0,18,0,4"/>
                                <TextBlock Text="Imported IPA packages are stored under your local application data folder." Style="{StaticResource MutedText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Security & compatibility" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="TweaksBar does not request or store your Apple ID password. A secure Apple signing flow will be integrated separately." Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
                                <TextBlock Text="No jailbreak, exploit, or iOS system modification is performed by this preview." Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>