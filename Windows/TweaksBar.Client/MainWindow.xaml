<Window x:Class="TweaksBar.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TweaksBar" Height="780" Width="1240"
        MinHeight="680" MinWidth="1020"
        Background="{StaticResource WindowBrush}"
        Foreground="#F4F4F5"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="43"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#273449"/>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#101722" CornerRadius="20" Padding="16">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="2,4,2,26">
                    <Border Width="48" Height="48" CornerRadius="15" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left">
                        <TextBlock Text="T" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="TweaksBar" FontSize="21" FontWeight="Bold" Margin="0,13,0,3"/>
                    <TextBlock Text="DEVICE CONTROL CENTER" FontSize="9" Foreground="#7E8BA0" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="WORKSPACE" Foreground="#718096" FontSize="10" FontWeight="Bold" Margin="8,0,0,10"/>
                    <Border Background="#243B60" CornerRadius="10" Padding="11" Margin="0,0,0,6">
                        <DockPanel>
                            <TextBlock Text="▣" Foreground="#83B5FF" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Overview" FontWeight="SemiBold"/>
                        </DockPanel>
                    </Border>
                    <Border CornerRadius="10" Padding="11" Margin="0,0,0,6">
                        <DockPanel><TextBlock Text="▤" Foreground="#9AA8BC" FontSize="16" Margin="0,0,12,0"/><TextBlock Text="My Devices" Foreground="#C6CEDA"/></DockPanel>
                    </Border>
                    <Border CornerRadius="10" Padding="11" Margin="0,0,0,6">
                        <DockPanel><TextBlock Text="☷" Foreground="#9AA8BC" FontSize="16" Margin="0,0,12,0"/><TextBlock Text="Tweak Library" Foreground="#C6CEDA"/></DockPanel>
                    </Border>
                    <Border CornerRadius="10" Padding="11" Margin="0,0,0,6">
                        <DockPanel><TextBlock Text="⚙" Foreground="#9AA8BC" FontSize="16" Margin="0,0,12,0"/><TextBlock Text="Diagnostics" Foreground="#C6CEDA"/></DockPanel>
                    </Border>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="#192332" CornerRadius="12" Padding="12" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="PREVIEW BUILD" Foreground="#A5C8FF" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="Core connection features are being built." Foreground="#8996A9" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,5,0,22">
                <StackPanel>
                    <TextBlock Text="Overview" FontSize="29" FontWeight="Bold"/>
                    <TextBlock Text="Manage your iPhone connection and device support." Foreground="#9CA3AF" FontSize="13" Margin="1,5,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#17283B" CornerRadius="12" Padding="13,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#F5B942" Margin="0,0,8,0"/>
                        <TextBlock Text="DEVICE NOT CONNECTED" Foreground="#C6D9F5" FontSize="10" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </DockPanel>

            <Border Grid.Row="1" Background="#172B48" CornerRadius="18" Padding="20" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Welcome to TweaksBar" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Connect your iPhone to begin device diagnostics and pairing." Foreground="#B8C9E2" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="58" Height="58" CornerRadius="17" Background="#294D7D">
                        <TextBlock Text="✦" FontSize="30" Foreground="#9AC5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Panel}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,15">
                            <TextBlock Text="Device connection" FontSize="19" FontWeight="SemiBold"/>
                            <Border DockPanel.Dock="Right" Background="#352D1C" CornerRadius="8" Padding="8,4">
                                <TextBlock Text="OFFLINE" Foreground="#F4C66A" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </DockPanel>
                        <Border Background="#101722" CornerRadius="14" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="No iPhone connected" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ConnectionStatus" Text="Start by checking Apple device support, then open TweaksBar on your iPhone." Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19"/>
                            </StackPanel>
                        </Border>
                        <Button Content="Discover iPhone" Style="{StaticResource PrimaryButton}" Click="DiscoverButton_Click"/>
                        <TextBlock Text="Discovery will use your local network. Approve the connection on your iPhone before pairing." Foreground="#8996A9" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Apple device support" FontSize="17" FontWeight="SemiBold"/>
                                <Ellipse Width="8" Height="8" Fill="#F5B942" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="DriverStatus" Text="Not checked yet" Foreground="#9CA3AF" Margin="0,8,0,15" TextWrapping="Wrap"/>
                            <Button Content="Check drivers" Style="{StaticResource SecondaryButton}" Click="CheckDriversButton_Click"/>
                            <Button Content="Open Apple support" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Click="InstallDriversButton_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="Wi-Fi Sync" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Enable wireless sync yourself in Apple Devices or iTunes after trusting this PC over USB." Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,8,0,14" FontSize="12"/>
                            <Button Content="Show setup instructions" Style="{StaticResource SecondaryButton}" Click="WifiHelpButton_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="3" Text="Diagnostics prototype · This build does not install jailbreaks or modify iOS system files." Foreground="#737B8C" FontSize="11" Margin="2,18,0,0"/>
        </Grid>
    </Grid>
</Window>