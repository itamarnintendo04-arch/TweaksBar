<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TweaksBar</AssemblyName>
    <RootNamespace>TweaksBar.Client</RootNamespace>
    <ApplicationIcon Condition="Exists('Assets\TweaksBar.ico')">Assets\TweaksBar.ico</ApplicationIcon>
  </PropertyGroup>
</Project>